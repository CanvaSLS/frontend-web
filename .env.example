# URLs de los microservicios de CanvaSLS (una por API Gateway, sin barra final).
# Copia este archivo a .env.local y completa el <api-id> de cada despliegue.
#
# En Amplify estas mismas variables van en la configuración de la app.
# Vite las incrusta en el bundle al compilar: NO pongas secretos aquí.

VITE_API_AUTH=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev
VITE_API_CURSOS=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev
VITE_API_EVAL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev
VITE_API_ANALITICA=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev
VITE_API_NOTIF=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev
VITE_API_PRACTICA=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev