# URLs de los microservicios de CanvaSLS (una por API Gateway, sin barra final).
# Copia este archivo a .env.local y pon los valores de tu despliegue.
# Las URLs cambian cada vez que se recrea el stack: sácalas con
#   aws apigateway get-rest-apis --query 'items[].{N:name,Id:id}' --output text
# y arma https://<id>.execute-api.us-east-1.amazonaws.com/dev
#
# En Amplify estas mismas variables van en la configuración de la app.
# Vite las incrusta en el bundle al compilar: NO pongas secretos aquí.

VITE_API_AUTH=https://708i3626o6.execute-api.us-east-1.amazonaws.com/dev
VITE_API_CURSOS=https://5voksi80e7.execute-api.us-east-1.amazonaws.com/dev
VITE_API_EVAL=https://865gwpgnlb.execute-api.us-east-1.amazonaws.com/dev
VITE_API_ANALITICA=https://fxtn17kir4.execute-api.us-east-1.amazonaws.com/dev
VITE_API_NOTIF=https://rso6z2pwqk.execute-api.us-east-1.amazonaws.com/dev
